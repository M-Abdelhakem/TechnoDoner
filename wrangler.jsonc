{
  // Vite's dist/ served as static assets, plus the co-op relay (worker/index.js): one Durable Object per kitchen code
  // (Room) and one that pairs Quick play presses (Lobby). An experiment: its only address is the workers.dev preview,
  // which the Worker marks noindex. A release adds "routes": [{ "pattern": "jommi.fi/games/berlin-bears/play*",
  // "zone_name": "jommi.fi" }] and prefix stripping in the Worker.
  // Deploy: `npx wrangler deploy` (or `node ../tools/publish.mjs . --to web`). Local: `npm run worker:dev` after a build.
  "name": "berlin-bears",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [ { "name": "ROOMS", "class_name": "Room" }, { "name": "LOBBY", "class_name": "Lobby" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] } ]
}
